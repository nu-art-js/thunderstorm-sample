{
  "name": "@app/frontend-vite",
  "version": "{{APP_VERSION}}",
  "private": true,
  "description": "Frontend Vite app (Firebase Hosting)",
  "keywords": [
    "TacB0sS",
    "frontend",
    "vite",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:nu-art-js/thunderstorm-template.git"
  },
  "license": "Apache-2.0",
  "author": "TacB0sS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "start": "vite"
  },
  "dependencies": {
    "@nu-art/ts-common": "?",
    "@nu-art/thunder-core": "?",
    "@nu-art/thunder-routing": "?",
    "@nu-art/thunder-ui-modules": "?",
    "@nu-art/thunder-widgets": "?",
    "@nu-art/user-account-frontend": "?",
    "@nu-art/password-auth-frontend": "?",
    "@nu-art/ts-styles": "?",
    "react": "?",
    "react-dom": "?",
    "react-router-dom": "?"
  },
  "devDependencies": {
    "@types/react": "?",
    "@types/react-dom": "?",
    "@types/react-router-dom": "?",
    "@vitejs/plugin-react": "?",
    "sass": "?",
    "vite": "?",
    "vite-plugin-node-polyfills": "?",
    "vite-plugin-svgr": "?"
  },
  "unitConfig": {
    "hasSelfHotReload": true,
    "servingPort": "{{PORT_FRONTEND}}",
    "type": "vite-hosting",
    "label": "Frontend Vite",
    "hostingDeployment": {
      "artifactRegistry": {
        "region": "{{ARTIFACT_REGION}}",
        "repository": "hosting-builds",
        "projectId": "{{ARTIFACT_PROJECT_ID}}"
      },
      "packageName": "app-frontend"
    },
    "envs": {
      "local": {
        "config": {
          "configUrl": "http://127.0.0.1:{{PORT_CONFIG}}/_config/frontend/manager.json?ns={{FIREBASE_PROJECT_LOCAL}}-default-rtdb"
        },
        "projectId": "{{FIREBASE_PROJECT_LOCAL}}"
      },
      "dev": {
        "config": {
          "configUrl": "https://replace-dev-default-rtdb.firebaseio.com/_config/frontend/manager.json"
        },
        "projectId": "replace-dev"
      },
      "staging": {
        "config": {
          "configUrl": "https://replace-staging-default-rtdb.firebaseio.com/_config/frontend/manager.json"
        },
        "projectId": "replace-staging"
      },
      "prod": {
        "config": {
          "configUrl": "https://replace-prod-default-rtdb.firebaseio.com/_config/frontend/manager.json"
        },
        "projectId": "replace-prod"
      }
    }
  },
  "type": "module",
  "publishConfig": {
    "directory": "dist"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  }
}
