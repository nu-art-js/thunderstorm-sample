{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowJs": true,
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "strict": true,
    "types": [
      "*"
    ],
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false
  }
}
